# ==========================================
# 🎬 BeWithYugace Studio — Environment Variables
# ==========================================

# 1. AI Model API Keys (Provide at least one)
# Get Gemini Key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get OpenAI Key (Optional): https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# 2. Database Connection
# Get MongoDB Atlas URI: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string_here
DATABASE_NAME=bewithyugace_studio

# 3. Web & Video Research APIs (Optional)
# Get YouTube Data API v3 Key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Get Tavily Search API Key (Optional): https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Server Host & Port
HOST=127.0.0.1
PORT=8000
